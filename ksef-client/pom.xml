<?xml version='1.0' encoding='UTF-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.alapierre.ksef-sdk</groupId>
        <artifactId>ksef-client-parent</artifactId>
        <version>${revision}</version>
    </parent>
    <artifactId>ksef-client</artifactId>
    <name>KSeF Client</name>
    <description>Independently maintained Java client for the KSeF 2.0 API</description>
    <url>https://github.com/alapierre/ksef-client-java-mf-fork</url>
    <dependencies>
        <dependency>
            <groupId>io.alapierre.ksef-sdk</groupId>
            <artifactId>ksef-json-serializer</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.alapierre.ksef-sdk</groupId>
            <artifactId>ksef-json-serializer-jackson</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.alapierre.ksef-sdk</groupId>
            <artifactId>ksef-json-serializer-gson</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>eu.europa.ec.joinup.sd-dss</groupId>
            <artifactId>dss-xades</artifactId>
            <version>${dss.version}</version>
        </dependency>
        <dependency>
            <groupId>eu.europa.ec.joinup.sd-dss</groupId>
            <artifactId>dss-token</artifactId>
            <version>${dss.version}</version>
        </dependency>
        <dependency>
            <groupId>eu.europa.ec.joinup.sd-dss</groupId>
            <artifactId>dss-utils-apache-commons</artifactId>
            <version>${dss.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>3.18.0</version>
        </dependency>
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcpkix-jdk18on</artifactId>
            <version>${bouncycastle.version}</version>
        </dependency>
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>${bouncycastle.version}</version>
        </dependency>
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>core</artifactId>
            <version>${zxing.version}</version>
        </dependency>
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>javase</artifactId>
            <version>${zxing.version}</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.13</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>jpms-runtime-classpath</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>build-classpath</goal>
                        </goals>
                        <configuration>
                            <includeScope>runtime</includeScope>
                            <outputFile>${project.build.directory}/jpms-runtime-classpath.txt</outputFile>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <id>jpms</id>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                        <configuration>
                            <summaryFile>${project.build.directory}/failsafe-reports/jpms-summary.xml</summaryFile>
                            <includes>
                                <include>**/JpmsIT.java</include>
                            </includes>
                            <failIfNoTests>true</failIfNoTests>
                            <systemPropertyVariables>
                                <jpms.buildDirectory>${project.build.directory}</jpms.buildDirectory>
                                <jpms.clientJar>${project.build.directory}/${project.build.finalName}.jar</jpms.clientJar>
                            </systemPropertyVariables>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>independent-json-client</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>
                                    <excludes>
                                        <exclude>com.fasterxml.jackson.*:*</exclude>
                                        <exclude>tools.jackson.*:*</exclude>
                                        <exclude>com.google.code.gson:*</exclude>
                                        <exclude>io.alapierre.ksef-sdk:ksef-json-serializer-*</exclude>
                                    </excludes>
                                    <includes>
                                        <include>*:*:*:*:test</include>
                                    </includes>
                                    <message>The client must depend only on the JSON contract; serializer implementations belong to the application or tests.</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>jaxb2-maven-plugin</artifactId>
                <version>3.2.0</version>
                <executions>
                    <execution>
                        <id>auth-token-model</id>
                        <goals>
                            <goal>xjc</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <sources>
                        <source>src/main/resources/xsd/AuthTokenRequest.xsd</source>
                    </sources>
                    <packageName>pl.akmf.ksef.sdk.client.model.xml</packageName>
                    <outputDirectory>${project.build.directory}/generated-sources/jaxb</outputDirectory>
                    <noGeneratedHeaderComments>true</noGeneratedHeaderComments>
                    <arguments>
                        <argument>-Xfluent-api</argument>
                    </arguments>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>com.sun.xml.bind</groupId>
                        <artifactId>jaxb-xjc</artifactId>
                        <version>${jaxb.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>com.sun.xml.bind</groupId>
                        <artifactId>jaxb-impl</artifactId>
                        <version>${jaxb.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.jvnet.jaxb2_commons</groupId>
                        <artifactId>jaxb2-fluent-api</artifactId>
                        <version>3.0</version>
                    </dependency>
                </dependencies>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <!-- XJC's episode descriptor contains a wall-clock timestamp and was not part of the old artifact. -->
                    <excludes>
                        <exclude>META-INF/JAXB/**</exclude>
                    </excludes>
                    <archive>
                        <manifestEntries>
                            <Automatic-Module-Name>io.alapierre.ksef.client</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>META-INF/JAXB/**</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.2.0</version>
                <executions>
                    <execution>
                        <id>delombok-for-javadoc</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <!-- Javadoc cannot process Lombok's onMethod_ annotations. -->
                                <pathconvert property="delombok.classpath" refid="maven.compile.classpath"/>
                                <java classname="lombok.launch.Main" fork="true" failonerror="true">
                                    <classpath refid="maven.compile.classpath"/>
                                    <arg value="delombok"/>
                                    <arg value="${project.basedir}/src/main/java"/>
                                    <arg value="--classpath"/>
                                    <arg value="${delombok.classpath}"/>
                                    <arg value="--encoding"/>
                                    <arg value="UTF-8"/>
                                    <arg value="-d"/>
                                    <arg value="${project.build.directory}/delombok"/>
                                </java>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <!-- Existing upstream Javadocs contain invalid tags/HTML; keep the migration API-neutral. -->
                <configuration>
                    <doclint>none</doclint>
                    <sourcepath>${project.build.directory}/delombok${path.separator}${project.build.directory}/generated-sources/jaxb</sourcepath>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>api-compatibility</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.github.siom79.japicmp</groupId>
                        <artifactId>japicmp-maven-plugin</artifactId>
                        <version>0.27.0</version>
                        <configuration>
                            <oldVersion>
                                <dependency>
                                    <groupId>io.alapierre.ksef-sdk</groupId>
                                    <artifactId>ksef-client</artifactId>
                                    <version>${api.baseline.version}</version>
                                    <type>jar</type>
                                </dependency>
                            </oldVersion>
                            <newVersion>
                                <file>
                                    <path>${project.build.directory}/${project.build.finalName}.jar</path>
                                </file>
                            </newVersion>
                            <!-- Comparison-only classpath for the Jackson-based 2.3.15 baseline.
                                 These are not project dependencies and are not shipped to consumers. -->
                            <dependencies>
                                <dependency>
                                    <groupId>com.fasterxml.jackson.core</groupId>
                                    <artifactId>jackson-core</artifactId>
                                    <version>${jackson.version}</version>
                                </dependency>
                                <dependency>
                                    <groupId>com.fasterxml.jackson.core</groupId>
                                    <artifactId>jackson-databind</artifactId>
                                    <version>${jackson.version}</version>
                                </dependency>
                                <dependency>
                                    <groupId>com.fasterxml.jackson.core</groupId>
                                    <artifactId>jackson-annotations</artifactId>
                                    <version>2.22</version>
                                </dependency>
                            </dependencies>
                            <parameter>
                                <accessModifier>protected</accessModifier>
                                <onlyModified>true</onlyModified>
                                <!-- Intentional JSON SPI migration; keep all other members checked. -->
                                <excludes>
                                    <exclude>pl.akmf.ksef.sdk.api.DefaultKsefClient#DefaultKsefClient(java.net.http.HttpClient,pl.akmf.ksef.sdk.api.KsefApiProperties,com.fasterxml.jackson.databind.ObjectMapper)</exclude>
                                    <exclude>pl.akmf.ksef.sdk.api.DefaultKsefClient#DefaultKsefClient(java.net.http.HttpClient,pl.akmf.ksef.sdk.api.KsefApiProperties,pl.akmf.ksef.sdk.system.headerobservation.ResponseHeaderObservationProperties,com.fasterxml.jackson.databind.ObjectMapper)</exclude>
                                    <exclude>pl.akmf.ksef.sdk.api.DefaultLighthouseKsefClient#DefaultLighthouseKsefClient(com.fasterxml.jackson.databind.ObjectMapper,java.net.http.HttpClient,java.lang.String,java.time.Duration,java.util.Map)</exclude>
                                    <exclude>pl.akmf.ksef.sdk.system.ExceptionHandler#ExceptionHandler(com.fasterxml.jackson.databind.ObjectMapper)</exclude>
                                </excludes>
                                <breakBuildOnBinaryIncompatibleModifications>true</breakBuildOnBinaryIncompatibleModifications>
                                <breakBuildOnSourceIncompatibleModifications>true</breakBuildOnSourceIncompatibleModifications>
                                <!-- The major version follows KSeF API, not SemVer. -->
                                <breakBuildBasedOnSemanticVersioning>false</breakBuildBasedOnSemanticVersioning>
                                <ignoreMissingClasses>false</ignoreMissingClasses>
                                <ignoreNonResolvableArtifacts>false</ignoreNonResolvableArtifacts>
                                <reproducibleReport>true</reproducibleReport>
                            </parameter>
                        </configuration>
                        <executions>
                            <execution>
                                <id>check-public-api</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>cmp</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>ksef-live</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <includes>
                                <include>**/*LiveIT.java</include>
                            </includes>
                            <failIfNoTests>true</failIfNoTests>
                            <forkedProcessTimeoutInSeconds>240</forkedProcessTimeoutInSeconds>
                        </configuration>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
